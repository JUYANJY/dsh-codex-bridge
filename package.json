{
  "name": "@juyanjy/dsh-codex-bridge",
  "version": "0.3.0",
  "description": "Observe and steer a local Codex (OpenAI) session from DeepSeek Harness, over the codex app-server protocol.",
  "license": "MIT",
  "author": "JUYANJY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUYANJY/dsh-codex-bridge.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./app-server": {
      "default": "./src/app-server.js"
    },
    "./client": {
      "default": "./src/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "install:plugin": "node scripts/install.mjs",
    "uninstall:plugin": "node scripts/uninstall.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
